{
  "name": "blockchain_and_defi_resources",
  "version": "1.0.0",
  "description": "Blockchain & DeFi Resources",
  "main": "server.js",
  "type": "module",
  "scripts": {
    "start": "node backend/server npm install --prefix frontend && npm run build --prefix frontend",
    "server": "nodemon backend/server",
    "client": "npm run start --prefix frontend",
    "dev": "concurrently \"npm run server\" \"npm run client\"",
    "build": "npm install --prefix frontend && CI=false npm run build --prefix frontend && rm -rf public && cp -R frontend/build public"
  },
  "keywords": [
    "Blockchain",
    "DeFi",
    "Decentralised",
    "Finance",
    "Ethereum"
  ],
  "author": "JLTDigital",
  "license": "ISC",
  "engines": {
    "node": "24.x"
  },
  "dependencies": {
    "colors": "^1.4.0",
    "cors": "^2.8.5",
    "dotenv": "^8.2.0",
    "express": "^4.17.1",
    "express-async-handler": "^1.1.4",
    "morgan": "^1.10.0"
  },
  "devDependencies": {
    "autoprefixer": "^10.4.19",
    "concurrently": "^6.0.1",
    "nodemon": "^2.0.7"
  }
}
